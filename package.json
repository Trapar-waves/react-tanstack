  "type": "module",
  "version": "1.2.0",
  "packageManager": "pnpm@11.22.0",
  "description": "A React template leveraging TanStack tools (Query, Router) for state management, routing, and data handling, with TypeScript, Tailwind CSS, and Rsbuild integration.",
  "author": {
