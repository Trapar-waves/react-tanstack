  },
  "license": "MIT",
  "homepage": "https://github.com/Trapar-waves/react-tanstack",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Trapar-waves/react-tanstack.git"
  },
  "bugs": {
    "url": "https://github.com/Trapar-waves/react-tanstack/issues"
  },
  "keywords": [
    "react",
    "tanstack",
    "rsbuild",
    "query",
    "router",
    "typescript",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "rsbuild dev --open",
