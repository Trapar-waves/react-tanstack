  },
  "bugs": {
    "url": "https://github.com/Trapar-waves/react-tanstack/issues"
  },
  "keywords": [
    "react",
    "tanstack",
    "rsbuild",
    "query",
    "router",
    "typescript",
    "tailwindcss"
  ],
  "publishConfig": {
    "access": "public"
